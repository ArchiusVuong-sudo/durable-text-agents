# Port for the web server (binds 127.0.0.1)
PORT=4106
# Force replay mode (recorded responses, no login or key needed)
DEMO_REPLAY=0
# Model for live runs: claude-sonnet-5-5, claude-opus-5-5 or claude-haiku-5-5
DTA_MODEL=claude-sonnet-5-5
# Optional: an API key instead of the local Claude Code login
ANTHROPIC_API_KEY=
